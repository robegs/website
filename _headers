/* Netlify _headers example. Adapt to your hosting provider. */

/* Apply to all routes */
/* / */
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' https://plausible.io; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://plausible.io; object-src 'none'; base-uri 'self'; frame-ancestors 'none';
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
